+	// lets draw_layer_byline skip tile rows whose pens are all transparent for the pass
+	TileRowPens = (UINT16*)BurnMalloc((graphics_mask[0] + 1) * 8 * sizeof(UINT16));
+	for (INT32 i = 0; i < (graphics_mask[0] + 1) * 8; i++) {
+		UINT16 pens = 0;
+		for (INT32 x = 0; x < 8; x++) pens |= 1 << (DrvGfxROM0[i * 8 + x] & 0x0f);
+		TileRowPens[i] = pens;
+	}
