# The U-Boot logo, centred, so the splash continues it without a jump.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo = Image("logo.png");
w = Window.GetWidth();
h = Window.GetHeight();
if (logo.GetWidth() > w || logo.GetHeight() > h)
  logo = logo.Scale(w, h);
sprite = Sprite(logo);
sprite.SetX(Window.GetX() + (w - logo.GetWidth()) / 2);
sprite.SetY(Window.GetY() + (h - logo.GetHeight()) / 2);
